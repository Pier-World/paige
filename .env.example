# Supabase (required for local dev)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Optional: overrides default https://joinpier.com/sign-up for login "apply here" links
# VITE_MARKETING_APPLY_URL=

# PostHog — Vite apps must use VITE_* (NEXT_PUBLIC_* is Next.js only)
# VITE_POSTHOG_PROJECT_TOKEN=
# VITE_POSTHOG_HOST=https://us.i.posthog.com
